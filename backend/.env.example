PORT=3001
MAX_RADIUS_KM=10
MAX_SITES=100
# How long one business website gets to answer before it is skipped
SITE_TIMEOUT_MS=4000
# OpenStreetMap services require a User-Agent that identifies your app and how to contact you
USER_AGENT=WorkRadar/0.1 (your-email@example.com)
# Local copy of OpenStreetMap places (see scripts/build-places.sh). Delete the file to go back to the Overpass API.
PLACES_DB=C:/osm-data/places.db
# Only used when there is no local database:
OVERPASS_URL=https://overpass-api.de/api/interpreter
# The public Overpass server is often busy (504) or rate-limits (429): how many extra tries, and the wait between them
OVERPASS_RETRIES=2
OVERPASS_RETRY_DELAY_MS=4000
# The built-in list already covers English, Spanish, Catalan, Portuguese, French, German, Italian and Dutch
# (see DEFAULT_KEYWORDS in src/config.ts). Set this only to replace it, earlier keywords winning:
# KEYWORDS=careers,jobs,trabaja con nosotros,empleo
